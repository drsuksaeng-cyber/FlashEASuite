# FlashEASuite V2 - Git Ignore

# MQL5 Compiled Files
*.ex5
*.ex4

# Python Compiled Files
*.pyc
*.pyo
__pycache__/
*.py[cod]
*$py.class

# Virtual Environment
venv/
env/
ENV/
.venv/

# Logs
*.log
logs/*.log
02_Brain/logs/*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Test Results
test_results/
*.csv
*.xlsx

# Temporary Files
*.tmp
*.temp
*.bak
*.backup

# ZIP Archives
*.zip
*.rar
*.7z
*.tar.gz

# Keys (Security)
*.key
*.key_secret

# Build Directories
build/
dist/
*.egg-info/

# Documentation Build
_build/
.doctrees/

# Jupyter Notebooks
.ipynb_checkpoints/

# Coverage Reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Pytest
.pytest_cache/

# Node (if any)
node_modules/
package-lock.json

# Exclude specific files
CLEANUP_LOG.txt
VERIFICATION.txt
folder_structure.txt

# Keep structure
!.gitkeep

__pycache__/
*.bat
backup/